generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  BENDAHARA
  KONTEN
  VIEWER
}

enum TxType {
  MASUK
  KELUAR
}

enum CategoryType {
  MASUK
  KELUAR
}

enum PeriodStatus {
  AKTIF
  DITUTUP
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
}

enum DonationStatus {
  MENUNGGU
  DIKONFIRMASI
  DITOLAK
}

model User {
  id           String      @id @default(cuid())
  name         String
  email        String      @unique
  passwordHash String
  role         Role        @default(VIEWER)
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  articles     Article[]
  transactions Transaction[]
  verifications Donation[]
}

model Section {
  id        String   @id @default(cuid())
  key       String   @unique
  title     String
  content   Json
  isVisible Boolean  @default(true)
  order     Int      @default(0)
  updatedAt DateTime @updatedAt
}

model Article {
  id             String        @id @default(cuid())
  title          String
  slug           String        @unique
  excerpt        String?
  coverImage     String?
  body           String
  category       String?
  status         ArticleStatus @default(DRAFT)
  seoTitle       String?
  seoDescription String?
  seoImage       String?
  viewCount      Int           @default(0)
  authorId       String
  author         User          @relation(fields: [authorId], references: [id])
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Category {
  id           String       @id @default(cuid())
  name         String
  type         CategoryType
  color        String?
  isActive     Boolean      @default(true)
  transactions Transaction[]
  proposals    Proposal[]
}

model Period {
  id           String        @id @default(cuid())
  name         String        @unique
  startDate    DateTime
  endDate      DateTime
  status       PeriodStatus  @default(AKTIF)
  closedAt     DateTime?
  closedBy     String?
  transactions Transaction[]
}

model Transaction {
  id           String     @id @default(cuid())
  type         TxType
  amount       Decimal    @db.Decimal(18, 2)
  date         DateTime
  description  String
  categoryId   String
  category     Category   @relation(fields: [categoryId], references: [id])
  periodId     String
  period       Period     @relation(fields: [periodId], references: [id])
  receiptImage String?
  createdBy    String
  creator      User       @relation(fields: [createdBy], references: [id])
  donationId   String?    @unique
  donation     Donation?  @relation(fields: [donationId], references: [id])
  acquisition  InventoryAcquisition?
  createdAt    DateTime   @default(now())

  @@index([periodId, date])
  @@index([date])
}

model Donation {
  id           String         @id @default(cuid())
  donorName    String
  amount       Decimal        @db.Decimal(18, 2)
  categoryId   String?
  message      String?
  proofImage   String?
  reference    String         @unique
  status       DonationStatus @default(MENUNGGU)
  rejectNote   String?
  verifiedById String?
  verifiedBy   User?          @relation(fields: [verifiedById], references: [id])
  verifiedAt   DateTime?
  createdAt    DateTime       @default(now())
  transaction  Transaction?
}

model PrayerTimeCache {
  date      String   @id
  city      String
  times     Json
  fetchedAt DateTime @default(now())
}

model PageView {
  id       String   @id @default(cuid())
  path     String
  referrer String?
  viewedAt DateTime @default(now())

  @@index([viewedAt])
  @@index([path, viewedAt])
}

model Track {
  id        String   @id @default(cuid())
  path      String
  referrer  String? 
  createdAt DateTime @default(now())
}

model Setting {
  key   String @id
  value Json
}

enum InventoryCategoryType {
  SARPRAS_UMUM
  ELEKTRONIK_AUDIO
  IBADAH_PENGAJIAN
  RUKUN_KEMATIAN
  KEBERSIHAN_DAPUR
}

enum LoanStatus {
  DIPINJAM
  KEMBALI_SEBAGIAN
  SELESAI
  TERLAMBAT
}

model InventoryItem {
  id            String                @id @default(cuid())
  code          String                @unique
  name          String
  category      InventoryCategoryType @default(SARPRAS_UMUM)
  location      String
  isBorrowable  Boolean               @default(true)
  totalQty      Int                   @default(1)
  availableQty  Int                   @default(1)
  borrowedQty   Int                   @default(0)
  brokenQty     Int                   @default(0)
  isWaqf        Boolean               @default(false)
  waqfDonor     String?
  priceEstimate Decimal?              @db.Decimal(18, 2)
  notes         String?
  image         String?
  loanItems     InventoryLoanItem[]
  acquisitions  InventoryAcquisition[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([category, isBorrowable])
}

model InventoryLoan {
  id              String              @id @default(cuid())
  code            String              @unique
  borrowerName    String
  borrowerPhone   String
  borrowerAddress String?
  purpose         String
  loanDate        DateTime            @default(now())
  expectedReturn  DateTime
  actualReturn    DateTime?
  status          LoanStatus          @default(DIPINJAM)
  officerOut      String
  officerIn       String?
  notes           String?
  items           InventoryLoanItem[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([status, expectedReturn])
  @@index([loanDate])
}

model InventoryLoanItem {
  id          String        @id @default(cuid())
  loanId      String
  loan        InventoryLoan @relation(fields: [loanId], references: [id], onDelete: Cascade)
  itemId      String
  item        InventoryItem @relation(fields: [itemId], references: [id])
  borrowedQty Int
  returnedQty Int           @default(0)
  brokenQty   Int           @default(0)
  missingQty  Int           @default(0)
}

model InventoryAcquisition {
  id            String        @id @default(cuid())
  itemId        String
  item          InventoryItem @relation(fields: [itemId], references: [id])
  quantity      Int
  source        String
  unitPrice     Decimal?      @db.Decimal(18, 2)
  donorName     String?
  officer       String
  date          DateTime      @default(now())
  notes         String?
  transactionId String?       @unique
  transaction   Transaction?  @relation(fields: [transactionId], references: [id])
}

enum ProgramPeriodType {
  PENDEK
  PANJANG
}

enum ProgramCategory {
  IDARAH
  IMARAH
  RIAYAH
  SOSIAL
}

enum ProgramStatus {
  DIRENCANAKAN
  BERJALAN
  SELESAI
  DITUNDA
}

enum ProposalStatus {
  DRAFT
  DIBUKA
  TERPENUHI
  SELESAI
}

model Program {
  id             String            @id @default(cuid())
  title          String
  slug           String            @unique
  description    String
  periodType     ProgramPeriodType @default(PENDEK)
  category       ProgramCategory   @default(IMARAH)
  status         ProgramStatus     @default(DIRENCANAKAN)
  progress       Int               @default(0) // 0 - 100
  targetDate     DateTime?
  budgetEstimate Decimal?          @db.Decimal(18, 2)
  picName        String?
  picPhone       String?
  order          Int               @default(0)
  isFeatured     Boolean           @default(false)
  proposals      Proposal[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([periodType, status])
}

model Proposal {
  id              String         @id @default(cuid())
  title           String
  slug            String         @unique
  summary         String
  description     String
  coverImage      String?
  filePdf         String?
  filePdfSize     String?
  targetAmount    Decimal        @db.Decimal(18, 2)
  collectedManual Decimal        @default(0) @db.Decimal(18, 2)
  categoryId      String?
  category        Category?      @relation(fields: [categoryId], references: [id])
  programId       String?
  program         Program?       @relation(fields: [programId], references: [id])
  startDate       DateTime?
  endDate         DateTime?
  status          ProposalStatus @default(DIBUKA)
  isFeatured      Boolean        @default(false)
  picName         String?
  picPhone        String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status, isFeatured])
  @@index([programId])
}

