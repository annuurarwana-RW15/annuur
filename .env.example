# DATABASE_URL
# Lokal: direct connection, port 5432 (Postgres biasa, tanpa pgbouncer).
#   DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/dkm_annur"
# Produksi (Supabase + Vercel): WAJIB Transaction Pooler, port 6543 — bukan 5432.
#   DATABASE_URL="postgresql://USER:PASSWORD@db.XXXX.supabase.co:6543/postgres?pgbouncer=true&connection_limit=1"
# Alasan: src/lib/db.ts memakai adapter @prisma/adapter-pg dengan pool pg bawaan
# (maks 10 koneksi/proses). Serverless Functions Vercel berjalan banyak proses;
# memakai direct connection (5432) berujung "too many connections" saat trafik naik.
DATABASE_URL=

AUTH_SECRET=
AUTH_TRUST_HOST=true
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
GA4_MEASUREMENT_ID=
